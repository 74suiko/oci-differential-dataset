{
  "ociVersion": "1.2.1",
  "root": {
    "path": "rootfs",
    "readonly": false
  },
  "hooks": {
    "prestart": [
      {
        "path": "/bin/sh",
        "args": ["sh", "-c", "echo '[Hook] prestart' >> /home/suiko/oci-lab/staging/youki-3186/rootfs/hook.log"]
      }
    ],
    "createContainer": [
      {
        "path": "/bin/sh",
        "args": ["sh", "-c", "echo '[Hook] createContainer' >> /home/suiko/oci-lab/staging/youki-3186/rootfs/hook.log"]
      }
    ]
  },
  "process": {
    "terminal": false,
    "user": {
      "uid": 0,
      "gid": 0
    },
    "args": [
      "sh", "-c", "cat /hook.log"
    ],
    "env": [
      "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    ],
    "cwd": "/"
  },
  "mounts": [
    { "destination": "/proc", "type": "proc", "source": "proc" },
    { "destination": "/dev", "type": "tmpfs", "source": "tmpfs" }
  ],
  "linux": {
    "namespaces": [
      { "type": "pid" },
      { "type": "network" },
      { "type": "ipc" },
      { "type": "uts" },
      { "type": "mount" }
    ]
  }
}